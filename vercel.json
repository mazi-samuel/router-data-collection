{
  "crons": [
    { "path": "/api/send-route-reminders", "schedule": "30 6 * * *" },
    { "path": "/api/send-route-reminders", "schedule": "30 9 * * *" },
    { "path": "/api/send-route-reminders", "schedule": "30 12 * * *" },
    { "path": "/api/send-route-reminders", "schedule": "30 15 * * *" },
    { "path": "/api/send-route-reminders", "schedule": "30 18 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|ico|webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
