# Paste your Google Apps Script Web App URL below to sync submissions to Google Sheets in production.
# Leave blank to use the local CSV files in local development.
VITE_GOOGLE_SHEETS_URL=""

# The secret API Key that matches ROUTER_API_KEY in Google Apps Script's Script Properties.
VITE_ROUTER_API_KEY=""

# Public VAPID key for Web Push notifications (safe to expose to the client —
# it's the public half of the key pair). The matching private key lives only
# as a server-side VAPID_PRIVATE_KEY env var on Vercel, used by
# api/send-route-reminders.js, never in this file.
VITE_VAPID_PUBLIC_KEY=""

